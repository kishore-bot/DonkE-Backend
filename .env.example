# Copy to .env.dev for the Podman backend. Fill in all four values below.
# Use a URL-safe database password and a separate auth secret of at least 32 bytes.
DONKE_POSTGRES_PASSWORD=
DONKE_AUTH_SECRET=

# Credentials for the local RustFS media store.
DONKE_OBJECTS_ACCESS_KEY=donke-local
DONKE_OBJECTS_SECRET_KEY=

# Optional Google web client ID. Match VITE_GOOGLE_CLIENT_ID on the frontend.
# DONKE_GOOGLE_CLIENT_ID=

# Optional Gemini key for AI features. The app has fallbacks when the key is unset.
# DONKE_GEMINI_API_KEY=

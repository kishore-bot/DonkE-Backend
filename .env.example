DONKE_PRACTICE_SESSION_TTL_SECONDS=3600
DONKE_PRACTICE_MAX_SESSIONS=128

# Leave PostgreSQL, Redis and the auth secret unset for local practice only.
# Use a database account created for DonkE and a unique random secret.
# DONKE_POSTGRES_DSN=postgresql+asyncpg://donke:REPLACE_ME@127.0.0.1:5432/donke
# DONKE_REDIS_DSN=redis://127.0.0.1:6379/0
# DONKE_AUTH_SECRET=
# DONKE_GOOGLE_CLIENT_ID=
# Compose uses service DNS for its DSNs and also requires this password.
# DONKE_POSTGRES_PASSWORD=

DONKE_REDIS_PREFIX=donke
DONKE_ACCESS_SECONDS=1800
DONKE_REFRESH_SECONDS=604800
# Grace period for retries after a refresh response is lost.
DONKE_REFRESH_REUSE_GRACE_SECONDS=20
DONKE_ADMIN_SESSION_SECONDS=900
DONKE_ROOM_TTL_SECONDS=3600
DONKE_QUEUE_TTL_SECONDS=120
DONKE_BOT_FILL_SECONDS=10
DONKE_CLAIM_LEASE_SECONDS=5
DONKE_MATCHMAKING_POLL_SECONDS=0.25

DONKE_ROOM_START_SECONDS=3
DONKE_TURN_SECONDS=40
DONKE_BOT_TURN_SECONDS=0.5
DONKE_MATCH_MINUTES=45
DONKE_MATCH_ARCHIVE_SECONDS=86400

# Swappable backends, picked from registries in app/modules/ai/providers/registry.py
# and app/core/storage.py. "none" turns the feature off.
# DONKE_AI_PROVIDER=gemini
# DONKE_STORAGE_PROVIDER=s3
# The app uses scripted commentary and rule text until a Gemini key is set.
# DONKE_GEMINI_API_KEY=
# Private bucket for approved season GLBs and WAV audio. Compose runs a local
# S3-compatible store ("objects", RustFS) and points the backend at it; set
# the DONKE_SEASON_MEDIA_* values and AWS credentials to use a hosted bucket.
# Use a long random secret, e.g. `openssl rand -hex 24`.
DONKE_OBJECTS_ACCESS_KEY=donke-local
DONKE_OBJECTS_SECRET_KEY=
# DONKE_SEASON_MEDIA_BUCKET=donke-season-media
# DONKE_SEASON_MEDIA_REGION=us-east-1
# DONKE_SEASON_MEDIA_ENDPOINT=http://objects:9000
# Address browsers use for signed reads, when it differs from the endpoint.
# DONKE_SEASON_MEDIA_PUBLIC_ENDPOINT=http://localhost:9000
# Browser origins allowed to read media (comma separated).
# DONKE_SEASON_MEDIA_CORS_ORIGINS=http://localhost:5173
DONKE_GEMINI_TEXT_MODEL=gemini-3.8-flash
DONKE_GEMINI_VOICE_MODEL=gemini-3.8-flash-tts
DONKE_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
DONKE_AI_TEXT_DAILY_CALLS=250
DONKE_AI_VOICE_DAILY_CALLS=100
DONKE_VOICE_CONCURRENCY=2
# Public HTTPS origin used in shared invite links, e.g. https://play.example.com.
# Leave empty to use the address each request arrived on.
# DONKE_PUBLIC_BASE_URL=
# Key that encrypts admin two-factor secrets (32+ random bytes). If unset it is
# derived from DONKE_AUTH_SECRET; changing either means admins re-enrol 2FA.
# DONKE_ADMIN_TOTP_KEY=
# Enables explicit demo data seeding on a dedicated development database.
DONKE_DEMO_MODE=false

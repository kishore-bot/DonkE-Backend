DONKE_PRACTICE_SESSION_TTL_SECONDS=3600
DONKE_PRACTICE_MAX_SESSIONS=128

# Leave PostgreSQL, Redis and the auth secret unset for local practice only.
# Use a database account created for DonkE and a unique random secret.
# DONKE_POSTGRES_DSN=postgresql+asyncpg://donke:REPLACE_ME@127.0.0.1:5432/donke
# DONKE_REDIS_DSN=redis://127.0.0.1:6379/0
# DONKE_AUTH_SECRET=
# DONKE_GOOGLE_CLIENT_ID=
# Compose uses service DNS for its DSNs and also requires this password.
# DONKE_POSTGRES_PASSWORD=

DONKE_REDIS_PREFIX=donke
DONKE_ACCESS_SECONDS=1800
DONKE_REFRESH_SECONDS=604800
DONKE_ADMIN_SESSION_SECONDS=900
DONKE_ROOM_TTL_SECONDS=3600
DONKE_QUEUE_TTL_SECONDS=120
DONKE_BOT_FILL_SECONDS=10
DONKE_CLAIM_LEASE_SECONDS=5
DONKE_MATCHMAKING_POLL_SECONDS=0.25

from typing import Literal

type BotLevel = Literal["easy", "medium", "hard"]

class PracticeGame:
    def __init__(
        self,
        seats: int,
        level: BotLevel = "easy",
        iterations: int = 300,
        ace_low: bool = False,
    ) -> None: ...
    @property
    def version(self) -> int: ...
    def snapshot(self) -> str: ...
    def hint(self, iterations: int = 200, seed: int | None = None) -> str: ...
    def play(self, card_json: str) -> tuple[PracticeGame, str]: ...

class OnlineGame:
    def __init__(self, seats: int, ace_low: bool = False) -> None: ...
    @staticmethod
    def seeded(seats: int, seed: int, ace_low: bool = False) -> OnlineGame: ...
    @staticmethod
    def restore(snapshot: str) -> OnlineGame: ...
    @property
    def turn(self) -> int | None: ...
    def snapshot(self) -> str: ...
    def view(self, seat: int) -> str: ...
    def exposed_leads(self, seat: int) -> str: ...
    def play(self, seat: int, card_json: str | None = None) -> str: ...
    def bot_move(
        self,
        seat: int,
        level: BotLevel = "hard",
        iterations: int = 300,
        seed: int | None = None,
    ) -> str | None: ...
    def evaluate(
        self, seat: int, iterations: int = 300, seed: int | None = None
    ) -> str: ...
    def story_move(self, seat: int, avoid_suit: str | None = None) -> str | None: ...
    def win_chances(
        self, iterations: int = 400, seed: int | None = None
    ) -> list[float]: ...
    def replay(self, plays_json: str) -> str: ...

class ChatFilter:
    def __init__(self, words: list[str]) -> None: ...
    def censor(self, text: str) -> str: ...
    def contains(self, text: str) -> bool: ...

def rank_passages(query: str, passages: list[str]) -> list[int]: ...
def select_table(
    candidates_json: str, config_json: str | None = None
) -> list[str] | None: ...
def fair_play_stats(decisions_json: str) -> str: ...

class PracticeGame:
    def __init__(self, seats: int) -> None: ...
    @property
    def version(self) -> int: ...
    def snapshot(self) -> str: ...
    def play(self, card_json: str) -> tuple[PracticeGame, str]: ...

class OnlineGame:
    def __init__(self, seats: int) -> None: ...
    @staticmethod
    def seeded(seats: int, seed: int) -> OnlineGame: ...
    @staticmethod
    def restore(snapshot: str) -> OnlineGame: ...
    @property
    def turn(self) -> int | None: ...
    def snapshot(self) -> str: ...
    def view(self, seat: int) -> str: ...
    def play(self, seat: int, card_json: str | None = None) -> str: ...

def rank_passages(query: str, passages: list[str]) -> list[int]: ...
